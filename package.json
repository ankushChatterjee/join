{
  "name": "join",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.2.10",
  "type": "module",
  "scripts": {
    "preinstall": "case \"$npm_config_user_agent\" in bun/*) ;; *) echo \"Use Bun only: run 'bun install'\"; exit 1;; esac",
    "hooks:install": "git config core.hooksPath .githooks",
    "dev": "vite",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "bun run lint:ts && bun run lint:rust && bun run lint:rust:fmt",
    "lint:ts": "bunx eslint . --ext .ts,.tsx",
    "lint:ts:fix": "bunx eslint . --ext .ts,.tsx --fix",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "lint:rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "test": "bun run test:quick",
    "test:quick": "bun run scripts/test.ts quick",
    "test:frontend": "bun run scripts/test.ts frontend",
    "test:frontend:ui": "bun run scripts/test.ts frontend",
    "test:rust": "bun run scripts/test.ts rust",
    "test:integration": "bun run scripts/test.ts integration",
    "test:all": "bun run scripts/test.ts all",
    "test:report": "bun run test:all",
    "sec:gitleaks": "bash scripts/security-gitleaks.sh",
    "sec:all": "bun run sec:gitleaks"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.49",
    "@ai-sdk/google": "^3.0.33",
    "@ai-sdk/openai": "^3.0.53",
    "@codemirror/lang-sql": "^6.10.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.3",
    "@openrouter/ai-sdk-provider": "^2.2.3",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.19",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-http": "^2.5.7",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@uiw/react-codemirror": "^4.25.5",
    "ai": "^6.0.103",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.3",
    "esbuild": "^0.27.3",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^0.575.0",
    "node-sql-parser": "^5.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.6.5",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sql-formatter": "^15.7.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tauri-apps/cli": "^2.10.0",
    "@types/diff": "^8.0.0",
    "@types/node": "^25.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "bun-types": "^1.3.10",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.3.1"
  },
  "overrides": {
    "@tauri-apps/api": "^2.10.1",
    "esbuild": "0.27.3"
  }
}
